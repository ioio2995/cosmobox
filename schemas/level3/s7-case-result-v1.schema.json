{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cosmobox.local/schemas/level3-s7-case-result-v1.schema.json",
  "title": "Cosmobox Level3 S7 case result (v1)",
  "description": "One (geometry, S=7) case's full result: per-multiplet source observables and derived metrics, plus the four regime analyses. Same shape as schemas/level3/s6-case-result-v1.schema.json (never reduced further -- run_case already produces exactly this information), with spin fixed to 7 (never 2, 3, 4, 5, or 6, which are the frozen references, never a new execution) and no S2/S3/S4/S5/S6 field of any kind: a case-result document describes exactly one new S7 case, nothing else.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "manifest_fingerprint",
    "repository",
    "repository_commit",
    "branch",
    "frozen_preregistration_commit",
    "numerical_guard_reference",
    "geometry",
    "spin",
    "dimension",
    "group_count",
    "full_spectrum",
    "solver_method",
    "window_truncated",
    "partial_subspace_count",
    "multiplet_entries",
    "regime_analyses"
  ],
  "properties": {
    "schema_version": {"const": "level3-s7-case-result-v1"},
    "campaign_id": {"type": "string", "minLength": 1},
    "manifest_fingerprint": {"type": "string", "minLength": 1},
    "repository": {"const": "ioio2995/cosmobox"},
    "repository_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "branch": {"type": "string", "minLength": 1},
    "frozen_preregistration_commit": {"const": "cc0ffdadbeb7d40fc443ab11150c9f47e3e12776"},
    "numerical_guard_reference": {"$ref": "#/$defs/numericalGuardReference"},
    "geometry": {"enum": ["triangle", "ring4", "ring5"]},
    "spin": {"const": 7},
    "dimension": {"type": "integer", "minimum": 1},
    "group_count": {"type": "integer", "minimum": 1},
    "full_spectrum": {"const": true},
    "solver_method": {"const": "dense"},
    "window_truncated": {"const": false},
    "partial_subspace_count": {"const": 0},
    "multiplet_entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/multipletEntry"}
    },
    "regime_analyses": {
      "type": "object",
      "additionalProperties": false,
      "required": ["M_TT", "R_eff", "A_QQ", "M_QQ"],
      "properties": {
        "M_TT": {"$ref": "#/$defs/regimeAnalysis"},
        "R_eff": {"$ref": "#/$defs/regimeAnalysis"},
        "A_QQ": {"$ref": "#/$defs/regimeAnalysis"},
        "M_QQ": {"$ref": "#/$defs/regimeAnalysis"}
      }
    }
  },
  "$defs": {
    "numericalGuardReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["guard_m_tt", "guard_r_eff", "guard_scope"],
      "properties": {
        "guard_m_tt": {"const": 1e-16},
        "guard_r_eff": {"const": 1e-15},
        "guard_scope": {"const": "DELTA_HL_ONLY"}
      }
    },
    "available": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "reason"],
      "properties": {
        "value": {"type": ["number", "null"]},
        "reason": {"type": ["string", "null"]}
      },
      "description": "value is None if and only if reason is set -- never both, never neither."
    },
    "regimeMean": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "reason", "evaluable_weight_fraction"],
      "properties": {
        "value": {"type": ["number", "null"]},
        "reason": {"type": ["string", "null"]},
        "evaluable_weight_fraction": {"type": "number", "minimum": 0, "maximum": 1.0000000001}
      }
    },
    "regimeAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["low", "mid", "high", "delta_hl", "delta_ml", "delta_hm"],
      "properties": {
        "low": {"$ref": "#/$defs/regimeMean"},
        "mid": {"$ref": "#/$defs/regimeMean"},
        "high": {"$ref": "#/$defs/regimeMean"},
        "delta_hl": {"$ref": "#/$defs/available"},
        "delta_ml": {"$ref": "#/$defs/available"},
        "delta_hm": {"$ref": "#/$defs/available"}
      }
    },
    "rhoQQEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["i", "j", "value", "null_reason"],
      "properties": {
        "i": {"type": "integer", "minimum": 0},
        "j": {"type": "integer", "minimum": 0},
        "value": {"type": ["number", "null"]},
        "null_reason": {"type": ["string", "null"]}
      },
      "description": "value is None if and only if null_reason is set -- never imputed, never replaced by 0."
    },
    "multipletEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "energy",
        "multiplicity",
        "epsilon",
        "q_start",
        "q_end",
        "q_midpoint",
        "m_tt",
        "r_eff",
        "a_qq",
        "m_qq",
        "c_tt_conn",
        "rho_qq"
      ],
      "properties": {
        "energy": {"type": "number"},
        "multiplicity": {"type": "integer", "minimum": 1},
        "epsilon": {"type": "number", "minimum": 0, "maximum": 1},
        "q_start": {"type": "number", "minimum": 0, "maximum": 1},
        "q_end": {"type": "number", "minimum": 0, "maximum": 1},
        "q_midpoint": {"type": "number", "minimum": 0, "maximum": 1},
        "m_tt": {"type": "number", "minimum": 0},
        "r_eff": {"$ref": "#/$defs/available"},
        "a_qq": {"type": "number", "minimum": 0, "maximum": 1},
        "m_qq": {"$ref": "#/$defs/available"},
        "c_tt_conn": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "array", "minItems": 1, "items": {"type": "number"}},
          "description": "Full N x N C_TT_conn matrix, diagonal included, row-major -- never reduced before persistence, exactly as Level2/S4/S5/S6's own case-result contract."
        },
        "rho_qq": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/rhoQQEntry"},
          "description": "Every ordered (i,j), i != j, pair -- exactly N*(N-1) entries."
        }
      }
    }
  }
}
