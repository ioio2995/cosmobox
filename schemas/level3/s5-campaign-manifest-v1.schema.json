{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cosmobox.local/schemas/level3-s5-campaign-manifest-v1.schema.json",
  "title": "Cosmobox Level3 S5 campaign manifest (v1)",
  "description": "Machine-readable transcription of the Level3 S5 second-extension scientific contract (docs/levels/level3/s5-second-extension-preregistration.md, frozen at commit 496ba9484a6d7df9beb738607a5ffe23a75219ad). Fixes exactly the three new (geometry, S=5) cases, the reference-Hamiltonian/full-spectrum requirement, the primary/control metric split, and pins BOTH the frozen Level2 (S2/S3) and frozen Level3 S4 reference campaign identities that supply the comparison data -- no scientific degree of freedom beyond what is already frozen.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "campaign_id",
    "schema_version",
    "branch",
    "frozen_preregistration_commit",
    "cases",
    "physical_parameters",
    "full_spectrum_required",
    "primary_metrics",
    "control_metrics",
    "primary_contrast",
    "numerical_guard_reference",
    "level2_reference",
    "level3_s4_reference",
    "expected_s5_dimensions",
    "validated_dense_capability",
    "forbidden_extensions"
  ],
  "properties": {
    "manifest_version": {"const": "level3-s5-reference-v1"},
    "campaign_id": {"type": "string", "minLength": 1},
    "schema_version": {"type": "string", "minLength": 1},
    "branch": {"type": "string", "minLength": 1},
    "frozen_preregistration_commit": {
      "const": "496ba9484a6d7df9beb738607a5ffe23a75219ad",
      "description": "The exact commit that froze docs/levels/level3/s5-second-extension-preregistration.md."
    },
    "cases": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["geometry", "spin"],
        "properties": {
          "geometry": {"enum": ["triangle", "ring4", "ring5"]},
          "spin": {"const": 5}
        }
      },
      "description": "Exactly the three new Level3 S5 cases, geometry-major order -- never S=2/S=3/S=4 (those come from the frozen references), never S=6."
    },
    "physical_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n_flavors", "j", "h", "t", "g_e", "k", "external_charges"],
      "properties": {
        "n_flavors": {"const": 2},
        "j": {"const": 1.0},
        "h": {"const": 0.0},
        "t": {"const": 1.0},
        "g_e": {"const": 1.0},
        "k": {"const": 1.0},
        "external_charges": {"const": 0.0}
      },
      "description": "Documentary only -- not consumed by execution; identical to Level2 and S4."
    },
    "full_spectrum_required": {"const": true},
    "primary_metrics": {
      "type": "array",
      "items": {"enum": ["M_TT", "R_eff"]},
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true
    },
    "control_metrics": {
      "type": "array",
      "items": {"enum": ["A_QQ", "M_QQ"]},
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true
    },
    "primary_contrast": {"const": "HIGH_MINUS_LOW"},
    "numerical_guard_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["guard_m_tt", "guard_r_eff", "guard_scope"],
      "properties": {
        "guard_m_tt": {"const": 1e-16},
        "guard_r_eff": {"const": 1e-15},
        "guard_scope": {"const": "DELTA_HL_ONLY"}
      },
      "description": "The frozen L2-C1 numerical zero-resolution guards, reused unchanged for the S4<->S5 taxonomy."
    },
    "level2_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["campaign_id", "manifest_fingerprint", "repository_commit", "frozen_preregistration_commit"],
      "properties": {
        "campaign_id": {"const": "level2-energy-regime-v1"},
        "manifest_fingerprint": {"const": "82dca9dee756f531375b31540b4f7d05c2c8ba1760150f2d9972f12a5da06fa4"},
        "repository_commit": {"const": "1feb03f41f9e73078efbc760dd2cba2b667e2ed0"},
        "frozen_preregistration_commit": {"const": "2d4c859db7939da51ee7d919889a18f4c7e229ed"}
      },
      "description": "The frozen Level2 campaign identity Level3 S5 pins as its exclusive S=2/S=3 source."
    },
    "level3_s4_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["campaign_id", "manifest_fingerprint", "repository_commit", "frozen_preregistration_commit"],
      "properties": {
        "campaign_id": {"const": "level3-s4-truncation-extension-v1"},
        "manifest_fingerprint": {"const": "3498677a4addc9c62c5e9c220cedb0dca135c9b293eee205420dcbce346d7cba"},
        "repository_commit": {"const": "ffb49da84111f778e45aa95b6d9e80b45d68f34c"},
        "frozen_preregistration_commit": {"const": "1c1d71f07dd6a7399b3965b2bb0acfa5c665991e"}
      },
      "description": "The frozen Level3 S4 campaign identity Level3 S5 pins as its exclusive S=4 source."
    },
    "expected_s5_dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["triangle", "ring4", "ring5"],
      "properties": {
        "triangle": {"const": 208},
        "ring4": {"const": 712},
        "ring5": {"const": 2512}
      },
      "description": "Hilbert-space dimensions established by the L3-N capability preflight -- reference data, cross-checked by the campaign's gates against the real run_case(...).dimension."
    },
    "validated_dense_capability": {
      "const": 2512,
      "description": "Must equal cosmobox.level3.execution.LEVEL3_VALIDATED_DENSE_DIMENSION_LIMIT (L3-O) -- an operational capacity limit, never a physical or convergence threshold."
    },
    "forbidden_extensions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string"},
      "description": "Documentary marker only -- the real enforcement is in code, never solely in this JSON field."
    }
  }
}
