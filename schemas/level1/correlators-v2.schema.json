{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cosmobox.local/schemas/level1-correlators-v2.schema.json",
  "title": "Cosmobox Level 1 correlator result (v2)",
  "description": "Strict, record_kind-discriminated Level 1B result schema. v1 (level1-correlators-v1.schema.json) is kept as a historical contract; the final 1B campaign uses v2.",
  "type": "object",
  "required": [
    "schema_version",
    "repository_commit",
    "manifest_fingerprint",
    "campaign_id",
    "identity",
    "provenance",
    "record_kind",
    "observable_kind",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "level1-correlators-v2"},
    "repository_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "manifest_fingerprint": {"type": "string"},
    "campaign_id": {"type": "string"},
    "identity": {"$ref": "#/$defs/identity"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "record_kind": {
      "enum": [
        "raw_observable",
        "normalized_observable",
        "restricted_diagnostic",
        "flavor_diagnostic",
        "orbit_statistic",
        "symmetry_label",
        "matching",
        "robustness"
      ]
    },
    "observable_kind": {
      "enum": [
        "C_QQ_raw", "C_TT_raw", "O_ij_raw",
        "C_QQ_conn", "C_TT_conn", "rho_QQ", "G_occ", "gamma_O",
        "raw_G", "flavor_singlet", "flavor_frobenius_squared", "flavor_singular_values", "flavor_singular_value_ratio",
        "flavor_casimir_label", "translation_character", "reflection_character"
      ]
    },
    "payload": {}
  },
  "allOf": [
    {
      "if": {"required": ["record_kind"], "properties": {"record_kind": {"const": "raw_observable"}}},
      "then": {
        "if": {"required": ["observable_kind"], "properties": {"observable_kind": {"const": "O_ij_raw"}}},
        "then": {"properties": {"payload": {"$ref": "#/$defs/complex"}}},
        "else": {"properties": {"payload": {"type": "number"}}}
      }
    },
    {
      "if": {"required": ["record_kind"], "properties": {"record_kind": {"const": "normalized_observable"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/normalizedMoment"}}}
    },
    {
      "if": {"required": ["record_kind"], "properties": {"record_kind": {"const": "restricted_diagnostic"}}},
      "then": {
        "properties": {
          "payload": {"oneOf": [{"$ref": "#/$defs/hermitianDiagnostic"}, {"$ref": "#/$defs/nonHermitianDiagnostic"}]}
        }
      }
    },
    {
      "if": {"required": ["record_kind"], "properties": {"record_kind": {"const": "flavor_diagnostic"}}},
      "then": {
        "allOf": [
          {
            "if": {"required": ["observable_kind"], "properties": {"observable_kind": {"const": "raw_G"}}},
            "then": {"properties": {"payload": {"$ref": "#/$defs/flavorMatrix"}}}
          },
          {
            "if": {"required": ["observable_kind"], "properties": {"observable_kind": {"const": "flavor_singlet"}}},
            "then": {"properties": {"payload": {"$ref": "#/$defs/complex"}}}
          },
          {
            "if": {"required": ["observable_kind"], "properties": {"observable_kind": {"const": "flavor_frobenius_squared"}}},
            "then": {"properties": {"payload": {"type": "number", "minimum": 0}}}
          },
          {
            "if": {"required": ["observable_kind"], "properties": {"observable_kind": {"const": "flavor_singular_values"}}},
            "then": {"properties": {"payload": {"type": "array", "items": {"type": "number", "minimum": 0}, "minItems": 2, "maxItems": 2}}}
          },
          {
            "if": {"required": ["observable_kind"], "properties": {"observable_kind": {"const": "flavor_singular_value_ratio"}}},
            "then": {"properties": {"payload": {"$ref": "#/$defs/normalizedMoment"}}}
          }
        ]
      }
    },
    {
      "if": {"required": ["record_kind"], "properties": {"record_kind": {"const": "orbit_statistic"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/orbitResultPayload"}}}
    },
    {
      "if": {"required": ["record_kind"], "properties": {"record_kind": {"const": "symmetry_label"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/symmetryLabel"}}}
    },
    {
      "if": {"required": ["record_kind"], "properties": {"record_kind": {"const": "matching"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/matchOutcome"}}}
    },
    {
      "if": {"required": ["record_kind"], "properties": {"record_kind": {"const": "robustness"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/robustnessResult"}}}
    },
    {
      "if": {"required": ["record_kind"], "properties": {"record_kind": {"const": "raw_observable"}}},
      "then": {"properties": {"observable_kind": {"enum": ["C_QQ_raw", "C_QQ_conn", "C_TT_raw", "C_TT_conn", "O_ij_raw"]}}}
    },
    {
      "if": {"required": ["record_kind"], "properties": {"record_kind": {"const": "normalized_observable"}}},
      "then": {"properties": {"observable_kind": {"enum": ["rho_QQ", "G_occ", "gamma_O"]}}}
    },
    {
      "if": {"required": ["record_kind"], "properties": {"record_kind": {"const": "restricted_diagnostic"}}},
      "then": {
        "properties": {
          "observable_kind": {
            "enum": [
              "C_QQ_raw", "C_QQ_conn", "C_TT_raw", "C_TT_conn", "O_ij_raw",
              "rho_QQ", "G_occ", "gamma_O",
              "raw_G", "flavor_singlet", "flavor_frobenius_squared", "flavor_singular_values", "flavor_singular_value_ratio"
            ]
          }
        }
      }
    },
    {
      "if": {"required": ["record_kind"], "properties": {"record_kind": {"const": "flavor_diagnostic"}}},
      "then": {
        "properties": {
          "observable_kind": {
            "enum": ["raw_G", "flavor_singlet", "flavor_frobenius_squared", "flavor_singular_values", "flavor_singular_value_ratio"]
          }
        }
      }
    },
    {
      "if": {"required": ["record_kind"], "properties": {"record_kind": {"const": "orbit_statistic"}}},
      "then": {
        "properties": {
          "observable_kind": {
            "enum": [
              "C_QQ_raw", "C_QQ_conn", "C_TT_raw", "C_TT_conn", "O_ij_raw",
              "rho_QQ", "G_occ", "gamma_O",
              "raw_G", "flavor_singlet", "flavor_frobenius_squared", "flavor_singular_values", "flavor_singular_value_ratio"
            ]
          }
        }
      }
    },
    {
      "if": {"required": ["record_kind"], "properties": {"record_kind": {"const": "symmetry_label"}}},
      "then": {"properties": {"observable_kind": {"enum": ["flavor_casimir_label", "translation_character", "reflection_character"]}}}
    },
    {
      "if": {"required": ["record_kind"], "properties": {"record_kind": {"const": "matching"}}},
      "then": {
        "properties": {
          "observable_kind": {
            "enum": [
              "C_QQ_raw", "C_QQ_conn", "C_TT_raw", "C_TT_conn", "O_ij_raw",
              "rho_QQ", "G_occ", "gamma_O",
              "raw_G", "flavor_singlet", "flavor_frobenius_squared", "flavor_singular_values", "flavor_singular_value_ratio",
              "flavor_casimir_label", "translation_character", "reflection_character"
            ]
          }
        }
      }
    },
    {
      "if": {"required": ["record_kind"], "properties": {"record_kind": {"const": "robustness"}}},
      "then": {
        "properties": {
          "observable_kind": {
            "enum": [
              "C_QQ_raw", "C_QQ_conn", "C_TT_raw", "C_TT_conn", "O_ij_raw",
              "rho_QQ", "G_occ", "gamma_O",
              "raw_G", "flavor_singlet", "flavor_frobenius_squared", "flavor_singular_values", "flavor_singular_value_ratio",
              "flavor_casimir_label", "translation_character", "reflection_character"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "complex": {
      "type": "object",
      "required": ["real", "imag"],
      "properties": {
        "real": {"type": "number"},
        "imag": {"type": "number"}
      },
      "additionalProperties": false
    },
    "spectralStatus": {"enum": ["complete_multiplet", "partial_subspace"]},
    "matchStatus": {
      "enum": ["exact_label_match", "ambiguous_cross_truncation_match", "target_group_not_in_window", "structurally_not_applicable"]
    },
    "nullReason": {
      "type": ["string", "null"],
      "enum": [
        "normalization_denominator_below_floor",
        "zero_local_charge_variance",
        "truncated_spectral_group",
        "ambiguous_cross_truncation_match",
        "target_group_not_in_window",
        "resource_guardrail_exceeded",
        "structurally_not_applicable",
        "not_applicable",
        null
      ]
    },
    "hamiltonianIdentity": {
      "type": "object",
      "required": ["J", "h_is_zero", "t", "g_E", "K"],
      "properties": {
        "J": {"type": "array", "items": {"type": "number"}, "minItems": 1},
        "h_is_zero": {"type": "boolean"},
        "t": {"type": "number"},
        "g_E": {"type": "number"},
        "K": {"type": "number"}
      },
      "additionalProperties": false
    },
    "spectralGroupIdentity": {
      "type": "object",
      "required": ["status", "multiplicity", "twice_T"],
      "properties": {
        "status": {"$ref": "#/$defs/spectralStatus"},
        "multiplicity": {"type": "integer", "minimum": 1},
        "twice_T": {"type": ["integer", "null"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "required": ["geometry", "spin", "n_flavors", "hamiltonian", "sector", "spectral_group", "path", "flavor_component", "normalization"],
      "properties": {
        "geometry": {"enum": ["triangle", "ring4", "ring5", "disk7"]},
        "spin": {"type": "integer", "minimum": 1},
        "n_flavors": {"const": 2},
        "hamiltonian": {"$ref": "#/$defs/hamiltonianIdentity"},
        "sector": {"type": "string", "minLength": 1},
        "spectral_group": {"$ref": "#/$defs/spectralGroupIdentity"},
        "path": {"type": ["array", "null"], "items": {"type": "integer", "minimum": 0}, "minItems": 1},
        "flavor_component": {"type": ["string", "null"]},
        "normalization": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["spectral_status", "source_type", "source_module", "match_status", "covariance_validated"],
      "properties": {
        "spectral_status": {"$ref": "#/$defs/spectralStatus"},
        "source_type": {"type": "string", "minLength": 1},
        "source_module": {"type": "string", "minLength": 1},
        "match_status": {"oneOf": [{"$ref": "#/$defs/matchStatus"}, {"type": "null"}]},
        "covariance_validated": {"type": ["boolean", "null"]}
      },
      "additionalProperties": false
    },
    "normalizedMoment": {
      "type": "object",
      "required": ["value", "null_reason"],
      "properties": {
        "value": {"type": ["number", "null"]},
        "null_reason": {"$ref": "#/$defs/nullReason"}
      },
      "additionalProperties": false,
      "if": {"required": ["value"], "properties": {"value": {"type": "null"}}},
      "then": {"required": ["null_reason"], "properties": {"null_reason": {"type": "string"}}},
      "else": {"properties": {"null_reason": {"const": null}}}
    },
    "hermitianDiagnostic": {
      "type": "object",
      "required": ["operator_kind", "status", "trace", "eigenvalues", "minimum", "maximum", "spectral_range", "frobenius_norm", "hermiticity_defect"],
      "properties": {
        "operator_kind": {"const": "hermitian"},
        "status": {"$ref": "#/$defs/spectralStatus"},
        "trace": {"type": "number"},
        "eigenvalues": {"type": "array", "items": {"type": "number"}, "minItems": 1},
        "minimum": {"type": "number"},
        "maximum": {"type": "number"},
        "spectral_range": {"type": "number", "minimum": 0},
        "frobenius_norm": {"type": "number", "minimum": 0},
        "hermiticity_defect": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "nonHermitianDiagnostic": {
      "type": "object",
      "required": ["operator_kind", "status", "trace", "singular_values", "frobenius_norm"],
      "properties": {
        "operator_kind": {"const": "non_hermitian"},
        "status": {"$ref": "#/$defs/spectralStatus"},
        "trace": {"$ref": "#/$defs/complex"},
        "singular_values": {"type": "array", "items": {"type": "number", "minimum": 0}, "minItems": 1},
        "frobenius_norm": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "flavorMatrix": {
      "type": "object",
      "required": ["status", "matrix"],
      "properties": {
        "status": {"$ref": "#/$defs/spectralStatus"},
        "matrix": {
          "type": "array",
          "items": {"type": "array", "items": {"$ref": "#/$defs/complex"}, "minItems": 2, "maxItems": 2},
          "minItems": 2,
          "maxItems": 2
        }
      },
      "additionalProperties": false
    },
    "symmetryLabel": {
      "type": "object",
      "required": ["kind", "value"],
      "properties": {
        "kind": {"enum": ["numeric", "not_applicable", "unavailable"]},
        "value": {"oneOf": [{"$ref": "#/$defs/complex"}, {"type": "null"}]}
      },
      "additionalProperties": false,
      "if": {"required": ["kind"], "properties": {"kind": {"const": "numeric"}}},
      "then": {"required": ["value"], "properties": {"value": {"$ref": "#/$defs/complex"}}},
      "else": {"properties": {"value": {"type": "null"}}}
    },
    "matchedGroupIdentity": {
      "type": "object",
      "required": ["status", "multiplicity", "twice_T", "translation_label", "reflection_label"],
      "properties": {
        "status": {"$ref": "#/$defs/spectralStatus"},
        "multiplicity": {"type": "integer", "minimum": 1},
        "twice_T": {"type": "integer", "minimum": 0},
        "translation_label": {"$ref": "#/$defs/symmetryLabel"},
        "reflection_label": {"$ref": "#/$defs/symmetryLabel"}
      },
      "additionalProperties": false
    },
    "matchOutcome": {
      "type": "object",
      "required": ["status", "matched_group"],
      "properties": {
        "status": {"$ref": "#/$defs/matchStatus"},
        "matched_group": {"oneOf": [{"$ref": "#/$defs/matchedGroupIdentity"}, {"type": "null"}]}
      },
      "additionalProperties": false,
      "if": {"required": ["status"], "properties": {"status": {"const": "exact_label_match"}}},
      "then": {"required": ["matched_group"], "properties": {"matched_group": {"$ref": "#/$defs/matchedGroupIdentity"}}},
      "else": {"properties": {"matched_group": {"type": "null"}}}
    },
    "robustnessResult": {
      "type": "object",
      "required": ["verdict", "null_reason", "gamma_o", "difference", "amplitude"],
      "properties": {
        "verdict": {"enum": ["robust", "non_robust", "indeterminate"]},
        "null_reason": {
          "type": ["string", "null"],
          "enum": [
            "ambiguous_cross_truncation_match",
            "target_group_not_in_window",
            "structurally_not_applicable",
            "truncated_spectral_group",
            null
          ]
        },
        "gamma_o": {"oneOf": [{"$ref": "#/$defs/normalizedMoment"}, {"type": "null"}]},
        "difference": {"type": ["number", "null"], "minimum": 0},
        "amplitude": {"type": ["number", "null"], "minimum": 0}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"required": ["verdict"], "properties": {"verdict": {"enum": ["robust", "non_robust"]}}},
          "then": {
            "required": ["gamma_o", "difference", "amplitude"],
            "properties": {
              "null_reason": {"const": null},
              "gamma_o": {"$ref": "#/$defs/normalizedMoment"},
              "difference": {"type": "number"},
              "amplitude": {"type": "number"}
            }
          }
        },
        {
          "if": {"required": ["verdict"], "properties": {"verdict": {"const": "indeterminate"}}},
          "then": {"required": ["null_reason"], "properties": {"null_reason": {"type": "string"}}}
        },
        {
          "if": {
            "required": ["null_reason"],
            "properties": {"null_reason": {"enum": ["ambiguous_cross_truncation_match", "target_group_not_in_window", "structurally_not_applicable"]}}
          },
          "then": {
            "properties": {
              "gamma_o": {"type": "null"},
              "difference": {"type": "null"},
              "amplitude": {"type": "null"}
            }
          }
        }
      ]
    },
    "orbitComparabilityKey": {
      "type": "object",
      "required": ["orbit_family", "path_length", "spectral_group_key", "status", "observable_kind", "normalization", "flavor_component", "hamiltonian_identity"],
      "properties": {
        "orbit_family": {"type": "string", "minLength": 1},
        "path_length": {"type": "integer", "minimum": 0},
        "spectral_group_key": {},
        "status": {"$ref": "#/$defs/spectralStatus"},
        "observable_kind": {"type": "string", "minLength": 1},
        "normalization": {"type": "string", "minLength": 1},
        "flavor_component": {"type": "string", "minLength": 1},
        "hamiltonian_identity": {}
      },
      "additionalProperties": false
    },
    "orbitResultPayload": {
      "type": "object",
      "required": ["orbit_mean", "orbit_max_pairwise_spread", "orbit_covariance_defect", "comparability_key", "element_count"],
      "properties": {
        "orbit_mean": {"$ref": "#/$defs/complex"},
        "orbit_max_pairwise_spread": {"type": "number", "minimum": 0},
        "orbit_covariance_defect": {"type": "number", "minimum": 0},
        "comparability_key": {"$ref": "#/$defs/orbitComparabilityKey"},
        "element_count": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  }
}
